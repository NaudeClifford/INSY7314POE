{
  "info": {
    "_postman_id": "95cd17fc-8d6c-4ddc-8680-0fd416d7720f",
    "name": "HustleHub Part 3 - Account Lockout Demo",
    "description": "Part 3 security feature: per-account lockout.\n\nRun with: npm run test:lockout (backend running, database seeded).\n\nFive wrong passwords for one account inside 15 minutes lock that account for 15 minutes (HTTP 429 with Retry-After). While locked even the correct password is refused. Unknown emails lock the same way, so the response cannot reveal which accounts exist. Other accounts are unaffected.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register a fresh account to lock",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"lockEmail\", `lockout.${Date.now()}@hustlehub.test`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Lockout Demo\",\n  \"email\": \"{{lockEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"Client\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Wrong password attempt 1 of 5 (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"Generic message, no hint about the lockout counter\", () => pm.expect(pm.response.json().message).to.eql(\"Invalid email or password.\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{lockEmail}}\",\n  \"password\": \"WrongPass1!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
