    {
      "name": "8. Password policy validation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\nconst rule = pm.variables.get(\"passwordRule\");\nconst submittedPassword = pm.variables.get(\"invalidPassword\");\n\npm.test(`${rule}: status is 400`, () => {\n  pm.response.to.have.status(400);\n});\n\npm.test(`${rule}: password validation error returned`, () => {\n  pm.expect(response.message).to.eql(\"Validation failed.\");\n\n  const passwordError = response.errors.find(\n    (error) => error.path === \"password\"\n  );\n\n  pm.expect(passwordError).to.exist;\n});\n\npm.test(`${rule}: password is not exposed`, () => {\n  pm.expect(pm.response.text()).not.to.include(submittedPassword);\n});"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const passwordCases = [\r\n  {\r\n    password: \"password1!\",\r\n    rule: \"missing uppercase letter\"\r\n  },\r\n  {\r\n    password: \"PASSWORD1!\",\r\n    rule: \"missing lowercase letter\"\r\n  },\r\n  {\r\n    password: \"Password!\",\r\n    rule: \"missing number\"\r\n  },\r\n  {\r\n    password: \"Password1\",\r\n    rule: \"missing special character\"\r\n  },\r\n  {\r\n    password: \"Pass1!\",\r\n    rule: \"too short\"\r\n  }\r\n];\r\n\r\nconst iteration = pm.info.iteration || 0;\r\nconst currentCase = passwordCases[iteration % passwordCases.length];\r\n\r\npm.variables.set(\"invalidPassword\", currentCase.password);\r\npm.variables.set(\"passwordRule\", currentCase.rule);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Password Test\",\n  \"email\": \"password.validation@example.com\",\n  \"password\": \"{{invalidPassword}}\",\n  \"role\": \"Client\"\n}",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
