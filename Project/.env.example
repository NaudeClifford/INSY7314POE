PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=https://localhost:5173
SSL_KEY_PATH=
SSL_CERT_PATH=
MONGO_URI=
# Database used when NODE_ENV=development (the seed script only runs against this one)
MONGO_DB_DEV=
# Database used when NODE_ENV=production
MONGO_DB_PROD=
# Used by migrate-mongo and the local data upgrade script
MONGO_DB_NAME=
JWT_SECRET=
JWT_EXPIRES_IN=

# Logging (see README "Logging and monitoring")
# error | warn | info (default) | debug
LOG_LEVEL=info
# "pretty" for readable terminal output; leave empty for one JSON object per line
LOG_FORMAT=
# Set to false to stop writing Project/server/logs/app.log and security.log
LOG_TO_FILE=true
# Better Stack cloud logging: both values come from your Better Stack source's
# Configure page. Leave empty to log to the terminal and local files only.
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGESTING_HOST=

# Account lockout (defaults: 5 failed attempts in 15 minutes locks for 15 minutes)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
