    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  },
